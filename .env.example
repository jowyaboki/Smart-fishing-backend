# Environment Configuration for Smart Fishing Morocco Backend

# Server port
PORT=3000

# Environment: development | test | production
NODE_ENV=development

# JWT Secret Key:
# MANDATORY in production! Must be at least 32 characters long.
# In production, default or predictable keys will be rejected at startup.
# Example generation: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_chars_secret_in_production

# JWT Expiration duration (e.g. 7d, 24h, 15m)
JWT_EXPIRES_IN=7d

# Path to the SQLite database
DATABASE_PATH=smart_fishing.db

# Optional Google Gemini API Key for AI features
GEMINI_API_KEY=

# CORS Allowed Origin(s)
# In development, '*' allows web inspection.
# In production, set to specific authorized origins (comma-separated or single domain).
# Android native mobile requests (without Origin header) are always allowed.
CORS_ORIGIN=*

# Trust proxy configuration (true, false, or number of hops / IP range)
# Enable if running behind NGINX, Cloudflare, or AWS ALB.
TRUST_PROXY=false
